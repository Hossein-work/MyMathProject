## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017 cache/options directory
.vs/

# MSTest test Results (اگر تست نویسی می‌کنید)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# فایل‌های بیلد و موقت ویژوال استودیو
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual C++ cache files (اگر از C++ استفاده نمی‌کنید قابل حذف است)
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler (اگر پروفایلینگ نمی‌کنید قابل حذف است)
*.psess
*.vsp
*.vspx

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# فایل‌های کاورج و تست
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Windows detritus
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Mac desktop service store files
.DS_Store

_NCrunch*